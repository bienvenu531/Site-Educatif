# =====================================================================
# Excellence — bienvenueduc.com
# Configuration Apache / LiteSpeed (Hostinger)
# À placer à la racine du site (public_html).
# IMPORTANT : sauvegardez l'éventuel .htaccess existant avant de le
# remplacer, et fusionnez les règles si Hostinger en impose.
# =====================================================================

Options -Indexes
AddDefaultCharset UTF-8
DirectoryIndex index.php index.html

# ---------------------------------------------------------------- HTTPS
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Forcer HTTPS et supprimer le « www » (adresse canonique sans www)
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://bienvenueduc.com%{REQUEST_URI} [L,R=301]
</IfModule>

# ------------------------------------------------------------- Sécurité
<IfModule mod_headers.c>
  # HSTS : à activer seulement si tous les sous-domaines sont en HTTPS.
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header unset X-Powered-By
</IfModule>

# --------------------------------------------------------- Page 404
ErrorDocument 404 /404.html

# --------------------------------------------------------- Performance
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  # HTML : toujours revalidé
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
  # Assets versionnés par ?v= : cache court pour pouvoir corriger vite
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# --------------------------------------------- Fichiers à ne pas servir
<FilesMatch "\.(env|sql|log|ini|bak|old|orig|md|zip|tar|gz|sh|py)$">
  Require all denied
</FilesMatch>

<Files ".htaccess">
  Require all denied
</Files>

# --------------------------------------------------- Erreurs PHP (prod)
# Décommenter pour masquer les erreurs au public (les logs restent côté serveur).
# php_flag display_errors off
# php_value error_log /home/LOGIN/logs/php-error.log
